        <Param val="tone" valType="num" updates="set every repeat" name="volume"/>
      </SoundComponent>
      <KeyboardComponent name="key_resp_trial" plugin="None">
        <Param val="'y','n'" valType="list" updates="constant" name="allowedKeys"/>
